{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "15",
  "globalEnv": [
    "PORT",
    "HUB_URL",
    "DATABASE_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_SALT",
    "NEXT_PUBLIC_API_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "DESEO_CLIENT_ID",
    "DESEO_CLIENT_SECRET",
    "OPENROUTER_API_KEY",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
