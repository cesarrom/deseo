{
  "name": "@deseo/connector-payload",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -- tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --external @deseo/connector-sdk --external @deseo/ast --external @deseo/types --external jsonwebtoken",
    "start": "node dist/index.js",
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:migrate": "dotenv -- drizzle-kit migrate",
    "register": "deseo register"
  },
  "dependencies": {
    "@deseo/ast": "workspace:*",
    "@deseo/connector-sdk": "workspace:*",
    "@deseo/types": "workspace:*",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
