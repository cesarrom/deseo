{
  "name": "deseo",
  "version": "1.0.0",
  "description": "SEO automation platform with AI-powered content generation",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "dotenv -- turbo build",
    "test": "dotenv -- turbo test",
    "db:generate": "dotenv -- pnpm run --filter @deseo/db db:generate",
    "db:migrate": "dotenv -- pnpm run --filter @deseo/db db:migrate",
    "lint": "dotenv -- turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "keywords": [
    "seo",
    "ai",
    "content-generation",
    "cms"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
