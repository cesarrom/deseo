http://deseo.askn.us {
	# Match all /api/* paths except /api/auth/* (which belongs to NextAuth in the web project)
	@api_routes {
		path /api/*
		not path /api/auth/*
	}
	handle @api_routes {
		uri strip_prefix /api
		reverse_proxy {$API_HOST:deseo-api}:3001
	}

	# API — strip /server prefix before proxying (legacy/alternative)
	handle_path /server/* {
		reverse_proxy deseo-api:3001
	}

	# GitHub connector
	handle_path /connectors/github/* {
		reverse_proxy {$CONNECTOR_GITHUB_HOST:deseo-connector-github}:3002
	}

	# GitHub CMS connector
	handle_path /connectors/github-cms/* {
		reverse_proxy {$CONNECTOR_GITHUB_CMS_HOST:deseo-connector-github-cms}:3005
	}

	# GSC connector
	handle_path /connectors/gsc/* {
		reverse_proxy deseo-connector-gsc:3003
	}

	# Payload connector
	handle_path /connectors/payload/* {
		reverse_proxy deseo-connector-payload:3004
	}

	# Web — catch-all
	handle {
		reverse_proxy deseo-web:3000
	}
}
